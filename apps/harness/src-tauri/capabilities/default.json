{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Takekit desktop shell (local CI spawn + video fs)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA" },
        { "path": "$RESOURCE/**" },
        { "path": "$TEMP/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "claude",
          "cmd": "claude",
          "args": true,
          "sidecar": false
        },
        {
          "name": "codex",
          "cmd": "codex",
          "args": true,
          "sidecar": false
        },
        {
          "name": "opencode",
          "cmd": "opencode",
          "args": true,
          "sidecar": false
        },
        {
          "name": "grok",
          "cmd": "grok",
          "args": true,
          "sidecar": false
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
