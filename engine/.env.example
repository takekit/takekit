# Optional overrides — never commit real secrets. Copy to engine/.env (npm run dev/start load it).
TAKEKIT_ENGINE_HOST=127.0.0.1
TAKEKIT_ENGINE_PORT=8787
# Defaults to <takekit>/pipeline (in-repo skill + video kit). Override only if needed:
# TAKEKIT_PIPELINE_ROOT=/Users/oldaquerios/dev/myGitHub/org_takekit/takekit/pipeline
# Where "Novo projeto" creates NN-name folders (default: <pipeline>/video/projects; also set in the app):
# TAKEKIT_PROJECTS_ROOT=/Volumes/ExternSSD/Movies
# Precedence: env > ~/.takekit/config.json > defaults (see docs/DEV_SPEC_MVP.md §5)
# TAKEKIT_DATA_DIR=/abs/path   (default: ~/.takekit)
TAKEKIT_EXECUTOR=claude-code
# TAKEKIT_MODEL=opus
# TAKEKIT_EFFORT=high            # reasoning effort, in the executor's vocabulary
# CLAUDE_BIN=/Users/oldaquerios/.local/bin/claude
# CODEX_BIN= / GROK_BIN= / OPENCODE_BIN=   (default: binary on PATH)
# TAKEKIT_SKIP_PERMS=0           # 1 = full access for every executor (legacy: TAKEKIT_CLAUDE_SKIP_PERMS)
# Música e filmburn do 09-jev (fora do repo, ver pipeline/video/kit/assets/OMITTED.md);
# passado aos agentes, que rodam o compose.py:
# TAKEKIT_ASSETS=/abs/path/assets   (pasta com music/ e filmburns/)
