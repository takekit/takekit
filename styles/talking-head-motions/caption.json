{
  "_doc": "Legenda o vídeo inteiro no ataque da fala. Os motores leem os style JSON abaixo; aqui fica o resumo e onde mexer.",
  "engine": "video/resolve/engine/captions_palco.py",
  "drafter": "video/resolve/pipeline/caption_jobs.py",
  "config": "video/resolve/styles/caption-style-config.json",
  "styles": {
    "face": "video/resolve/styles/palco-face.json",
