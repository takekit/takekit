    "hold": "video/resolve/styles/palco-hold.json"
  },
  "fonts": {
    "sans": "assets/fonts/hetrixotypeface-extrabold.otf",
    "script": "assets/fonts/fontspring-demo-alvitonovacomp-bolditalic.otf"
  },
  "words": { "min": 1, "max": 3 },
  "timing": { "leadFrames": 2, "inFrames": 4, "outFrames": 3, "gapFrames": 8 },
