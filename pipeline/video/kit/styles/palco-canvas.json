{
  "_doc": "Caption palco B/C: Hetrixo tinta no creme. Mesmo contrato de duas linhas do caption-style-config. Sem tetris, sem glow.",
  "engine": "captions_palco.py",
  "layout": "canvas",
  "caption_config": "styles/caption-style-config.json",
  "font_sans": "assets/fonts/hetrixotypeface-extrabold.otf",
